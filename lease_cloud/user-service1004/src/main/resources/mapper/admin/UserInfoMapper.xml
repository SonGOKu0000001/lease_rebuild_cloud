<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kami.cloud.lease.web.admin.mapper.UserInfoMapper">

    <select id="pageUserInfo" resultType="com.kami.cloud.lease.model.entity.UserInfo">
        select phone,
               password,
               avatar_url,
               nickname,
               status
        from user_info
        where is_deleted = 0
    </select>
</mapper>
