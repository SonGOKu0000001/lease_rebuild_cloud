# 脱敏模板：复制为 application.yml 并填入真实配置（application.yml 已被 .gitignore 忽略，不会上传 Gitee）
server:
  port: 1004

spring:
  application:
    name: lease-user-service
  datasource:
    type: com.zaxxer.hikari.HikariDataSource
    url: jdbc:mysql://${MYSQL_HOST}:3306/lease_user?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
    username: ${MYSQL_USER}
    password: ${MYSQL_PASSWORD}
    hikari:
      connection-test-query: SELECT 1
      connection-timeout: 60000
      maximum-pool-size: 12
      minimum-idle: 10
  jackson:
    time-zone: GMT+8
  servlet:
    multipart:
      max-file-size: 100MB
      max-request-size: 100MB
  data:
    redis:
      host: ${REDIS_HOST}
      port: 6379
      database: 0
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
          max-wait: -1ms
        shutdown-timeout: 100ms
      timeout: 3000ms
  cloud:
    sentinel:
      transport:
        dashboard: localhost:8080
        port: 8719
      log:
        dir: E:/logs/myapp/sentinel
    nacos:
      server-addr: 127.0.0.1:8848

mybatis-plus:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

springdoc:
  default-flat-param-object: true

# Seata 分布式事务客户端（RM 分支写库）
seata:
  enabled: true
  application-id: lease-user-service
  tx-service-group: lease-cloud-tx-group
  registry:
    type: nacos
    nacos:
      server-addr: 127.0.0.1:8848
      application: seata-server
      group: SEATA_GROUP
  service:
    vgroup-mapping:
      lease-cloud-tx-group: default
