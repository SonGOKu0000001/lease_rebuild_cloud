# 脱敏模板：复制为 application-test.yml 并填入真实配置（application-test.yml 已被 .gitignore 忽略，不会上传 Gitee）
spring:
  mail:
    host: smtp.qq.com          # 邮件服务器地址
    port: 587                  # 或 465 (SSL)
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD} # 这里填邮箱授权码，不是登录密码
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true       # 启用TLS加密
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000
