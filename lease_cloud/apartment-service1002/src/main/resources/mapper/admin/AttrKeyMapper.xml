<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kami.cloud.lease.web.admin.mapper.AttrKeyMapper">
    <resultMap id="AttrKeyMap" type="com.kami.cloud.lease.web.admin.vo.attr.AttrKeyVo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <collection property="attrValueList" ofType="com.kami.cloud.lease.model.entity.AttrValue">
            <id property="id" column="attr_value_id"/>
            <result property="name" column="attr_value_name"/>
            <result property="attrKeyId" column="attr_key_id"/>
        </collection>
    </resultMap>
    <select id="listAttrInfo" resultMap="AttrKeyMap">
        select k.id,
               k.name,
               v.id   attr_value_id,
               v.name attr_value_name,
               v.attr_key_id

        from attr_key k
                 left join attr_value v
        on k.id = v.attr_key_id and v.is_Deleted = 0
        where k.is_Deleted = 0
    </select>
</mapper>
