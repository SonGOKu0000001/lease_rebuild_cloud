# 脱敏模板：复制为 application.yml 并填入真实配置（application.yml 已被 .gitignore 忽略，不会上传 Gitee）
# JWT 签名密钥（JwtUtil 通过 @Value 读取）：至少 256 位（32 字节）以上的字符串
jwt:
  sign-key: ${JWT_SIGN_KEY}

server:
  port: 1001

spring:
  application:
    name: lease-auth-service
  autoconfigure:
    exclude:
      - org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration
      - com.baomidou.mybatisplus.autoconfigure.MybatisPlusAutoConfiguration
  jackson:
    time-zone: GMT+8
  data:
    redis:
      host: ${REDIS_HOST}
      port: 6379
      database: 0
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
          max-wait: -1ms
        shutdown-timeout: 100ms
      timeout: 3000ms
  cloud:
    sentinel:
      transport:
        dashboard: localhost:8080
        port: 8719
      log:
        dir: E:/logs/myapp/sentinel
    nacos:
      server-addr: 127.0.0.1:8848

springdoc:
  default-flat-param-object: true

# 认证服务无需数据源，禁用 MyBatis 相关配置
lease:
  mybatis:
    enabled: false

# Seata 分布式事务客户端（TM 发起者，无本地数据源）
seata:
  enabled: true
  application-id: lease-auth-service
  tx-service-group: lease-cloud-tx-group
  enable-auto-data-source-proxy: false
  registry:
    type: nacos
    nacos:
      server-addr: 127.0.0.1:8848
      application: seata-server
      group: SEATA_GROUP
  service:
    vgroup-mapping:
      lease-cloud-tx-group: default
